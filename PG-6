package javaProgramming;
import java.util.Scanner;

class InvalidAgeException extends Exception {
    InvalidAgeException(String msg) {
        super(msg);
    }
}

class InvalidHeightException extends Exception {
    InvalidHeightException(String msg) {
        super(msg);
    }
}

public class AgeDivisionMenu {
    static void validateAge(int age) throws InvalidAgeException {
    	if(age<0) {
    		throw new InvalidAgeException("Age Cannot be negative. Age should be greater than 0");
    	}
    	else if (age < 18) {
            throw new InvalidAgeException("Not Eligible for Service because of less Age");
    	}
    	else {
        System.out.println("Eligible for Next Round");
    	}
    }
    
    
    static void validateHeight(float height) throws InvalidHeightException {
    	if(height<=(5.6)) {
    		throw new InvalidHeightException("Not Eligible for Service because of short Height");
    	}
    	else {
    		System.out.println("Eligible for Service");
    	}
    }
    
    static int divide(int a, int b) {
        if (b == 0)
            throw new ArithmeticException("Cannot divide by zero");
        return a/b;
    }

    public static void main(String[] args) {

        Scanner sc = new Scanner(System.in);
        int choice, age, a1, a2, result;
        float h;

        while (true) {
            System.out.println("\n--- MENU ---");
            System.out.println("1. To Validate Age");
            System.out.println("2. To Validate Height");
            System.out.println("3. To Divide two Numbers");
            System.out.println("4. To Exit");
            System.out.print("Enter your choice: ");
            choice = sc.nextInt();

            try {
                switch (choice) {

                    case 1:
                        System.out.print("Enter your age: ");
                        age = sc.nextInt();
                        validateAge(age);
                        break;
                        
                    case 2:
                        System.out.print("Enter your height: ");
                        h = sc.nextFloat();
                        validateHeight(h);
                        break;

                    case 3:
                        System.out.print("Enter First number: ");
                        a1 = sc.nextInt();
                        System.out.print("Enter Second number: ");
                        a2 = sc.nextInt();
                        result=divide(a1, a2);
                        System.out.println("Division of two numbers is: " + result);
                        break;

                    case 4:
                        System.out.println("Program terminated");
                        break;

                    default:
                        System.out.println("Invalid choice");
                }
            }
            catch (InvalidAgeException e) {
                System.out.println("Custom Exception:  " +e.getMessage());
            }
            catch (InvalidHeightException e) {
                System.out.println("Custom Exception:  " +e.getMessage());
            }
            catch (ArithmeticException e) {
                System.out.println("Predefined Exception:  " +e.getMessage());

            }
            
        } 
    }
}
